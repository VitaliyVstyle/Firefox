{
    "manifest_version": 3,
    "browser_specific_settings": {
        "gecko": {
            "id": "__newtabpage@vitaliy.com",
            "strict_min_version": "117.0",
            "update_url": "https://vitaliyvstyle.github.io/WebExtExperiments/updates.json"
        }
    },
    "name": "New Tab Page",
    "short_name": "NewTabPage",
    "author": "Vitaliy",
    "version": "2025.6.15",
    "description": "__MSG_extDescription__",
    "homepage_url": "https://github.com/VitaliyVstyle/VitaliyVstyle.github.io",
    "default_locale": "en-US",
    "permissions": [
        "storage",
        "cookies",
        "bookmarks",
        "history",
        "downloads",
        "tabs",
        "tabHide",
        "menus",
        "search"
    ],
    "icons": {
        "16": "icon.svg",
        "32": "icon.svg",
        "48": "icon.svg",
        "96": "icon.svg"
    },
    "options_ui": {
        "open_in_tab": true,
        "page": "options.xhtml"
    },
    "chrome_url_overrides": {
    	"newtab": "new_tab_page.html"
    },
    "chrome_settings_overrides": {
    	"homepage": "new_tab_page.html"
    },
    "background": {
        "scripts": ["background.js"]
    }
}
