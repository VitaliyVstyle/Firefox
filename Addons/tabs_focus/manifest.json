{
    "manifest_version": 3,
    "browser_specific_settings": {
        "gecko": {
            "id": "tabs_focus@vitaliy.com",
            "strict_min_version": "117.0",
            "update_url": "https://raw.githubusercontent.com/VitaliyVstyle/Firefox/refs/heads/main/updates.json"
        }
    },
    "name": "Tabs Focus",
    "short_name": "TabsFocus",
    "author": "Vitaliy",
    "version": "2026.8.20",
    "description": "__MSG_extDescription__",
    "homepage_url": "https://github.com/VitaliyVstyle/Firefox/tree/main/tabs_focus",
    "default_locale": "en-US",
    "icons": {
        "16": "svg/icon.svg",
        "32": "svg/icon.svg",
        "48": "svg/icon.svg",
        "96": "svg/icon.svg"
    },
    "options_ui": {
        "open_in_tab": true,
        "page": "options.xhtml"
    },
    "experiment_apis": {
        "TabsFocus": {
            "schema": "schema.json",
            "parent": {
                "scopes": ["addon_parent"],
                "paths": [["TabsFocus"]],
                "script": "parent.js",
                "events": ["startup"]
            }
        }
    }
