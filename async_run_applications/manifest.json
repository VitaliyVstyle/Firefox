{
    "manifest_version": 3,
    "browser_specific_settings": {
        "gecko": {
            "id": "async_run_applications@vitaliy.com",
            "strict_min_version": "117.0",
            "update_url": "https://vitaliyvstyle.github.io/WebExtExperiments/updates.json"
        }
    },
    "name": "Async Run Applications",
    "short_name": "AsyncRunApp",
    "author": "Vitaliy",
    "version": "2025.11.30",
    "description": "__MSG_extDescription__",
    "homepage_url": "https://github.com/VitaliyVstyle/VitaliyVstyle.github.io",
    "default_locale": "en-US",
    "permissions": [
        "storage",
        "cookies",
        "menus"
    ],
    "icons": {
        "16": "svg/icon.svg",
        "32": "svg/icon.svg",
        "48": "svg/icon.svg",
        "96": "svg/icon.svg"
    },
    "options_ui": {
        "open_in_tab": true,
        "page": "options.xhtml"
    },
    "background": {
        "scripts": ["background.js"]
    },
    "experiment_apis": {
        "AsyncRunApp": {
            "schema": "schema.json",
            "parent": {
                "scopes": ["addon_parent"],
                "paths": [["AsyncRunApp"]],
                "script": "parent.js"
            }
        }
    }
}
